{
  "name": "cx-exam-ai-v2",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "CX 考试 AI 大脑 v2：考试专用、共享核心、Chrome 扩展与 Tampermonkey 双外壳",
  "license": "MIT",
  "author": "wzj1122",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:extension && npm run build:userscript && npm run build:site",
    "build:extension": "vite build --config apps/extension/vite.config.ts",
    "build:userscript": "vite build --config apps/userscript/vite.config.ts",
    "build:web": "vite build --config apps/web-settings/vite.config.ts",
    "build:site": "npm run build:web && node scripts/build-site.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "smoke:userscript": "node tests/smoke-userscript.mjs",
    "smoke:extension": "node tests/smoke-extension.mjs",
    "dev:extension": "vite --config apps/extension/vite.config.ts",
    "dev:userscript": "vite --config apps/userscript/vite.config.ts",
    "smoke": "npm run smoke:userscript && npm run smoke:extension",
    "live:inject": "node tools/live-inject.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.1.28",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@crxjs/vite-plugin": "^3.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
