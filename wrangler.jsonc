{
  // Cloudflare **Pages** 部署配置（主通道：https://cx-exam-ai.pages.dev）。
  // 只发布 tools/build-site.js 生成的 .site/ —— 绝不把仓库根目录整站直出，
  // 根目录含 logs/、.cdp-profile/、.chrome-profile/ 等本地产物，浏览器 profile 里是登录态 Cookie。
  //
  // 本地发布：  npm run site && npx wrangler pages deploy .site --project-name=cx-exam-ai --branch=main
  // 控制台 Git 部署（可选）：构建命令 npm run site ／ 构建输出目录 .site
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cx-exam-ai",
  "compatibility_date": "2026-11-16",
  "pages_build_output_dir": "./.site",
  // 配置云同步用的 KV（functions/api/sync/[id].js 里以 env.CFG_KV 访问）。
  // 只存 AES-GCM 密文 + 写权限令牌，客户端密钥从不上传（零知识）。
  "kv_namespaces": [
    {
      "binding": "CFG_KV",
      "id": "82987ae0f84d4ee18b3062cf666ab14e"
    }
  ]
}
